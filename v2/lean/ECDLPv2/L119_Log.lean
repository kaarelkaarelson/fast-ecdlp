import Mathlib
import ECDLPv2.L116_Gens

/-!
# L119 / Log: every finite abelian group is generated by at most `log2 |G|` elements

`exists_hasGen_log`: for a finite additive abelian group `G` there is `r` with `2^r ≤ |G|` and `HasGen G r`.
Proof: greedy chain of subgroups; each new non-member element at least doubles the subgroup.
-/
set_option linter.unusedSectionVars false
set_option linter.deprecated false
namespace ECDLP.L119

open ECDLP.L116

variable {G : Type*} [AddCommGroup G] [Finite G]

theorem card_double (K : AddSubgroup G) (x : G) (hx : x ∉ K) :
    2 * Nat.card K ≤ Nat.card (K ⊔ AddSubgroup.zmultiples x : AddSubgroup G) := by
  set K' := K ⊔ AddSubgroup.zmultiples x with hK'
  have hle : K ≤ K' := le_sup_left
  have hdvd : Nat.card K ∣ Nat.card K' := AddSubgroup.card_dvd_of_le hle
  have hne : K ≠ K' := by
    intro h
    apply hx
    rw [h]
    exact (le_sup_right : AddSubgroup.zmultiples x ≤ K') (AddSubgroup.mem_zmultiples x)
  have hlt : Nat.card K < Nat.card K' := by
    refine lt_of_le_of_ne (Nat.card_le_card_of_injective _ (Set.inclusion_injective hle)) ?_
    intro h
    exact hne (AddSubgroup.eq_of_le_of_card_ge hle h.symm.le)
  obtain ⟨c, hc⟩ := hdvd
  have hpos : 0 < Nat.card K := Nat.card_pos
  rw [hc] at hlt ⊢
  have : 1 < c := by
    by_contra h
    push Not at h
    interval_cases c <;> simp at hlt
  nlinarith

/-- chain step: `K` generated by `r` elements with `2^r ≤ |K|`; reach `⊤`. -/
theorem chain : ∀ (n : ℕ) (K : AddSubgroup G) (r : ℕ) (g : Fin r → G),
    Nat.card G - Nat.card K ≤ n → AddSubgroup.closure (Set.range g) = K → 2 ^ r ≤ Nat.card K →
    ∃ (r' : ℕ), 2 ^ r' ≤ Nat.card G ∧ HasGen G r' := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro K r g hn hg h2
  by_cases hK : K = ⊤
  · refine ⟨r, ?_, g, by rw [hg, hK]⟩
    calc 2 ^ r ≤ Nat.card K := h2
      _ ≤ Nat.card G := Nat.card_le_card_of_injective _ K.subtype_injective
  · obtain ⟨x, hx⟩ : ∃ x, x ∉ K := by
      by_contra h; push Not at h; exact hK (eq_top_iff.2 fun x _ => h x)
    have hd := card_double K x hx
    set K' := K ⊔ AddSubgroup.zmultiples x with hK'
    have hKG : Nat.card K' ≤ Nat.card G := Nat.card_le_card_of_injective _ K'.subtype_injective
    have hpos : 0 < Nat.card K := Nat.card_pos
    refine ih (Nat.card G - Nat.card K') (by have := Nat.card_pos (α := K); omega) K' (r + 1)
      (Fin.cons x g) le_rfl ?_ ?_
    · have : Fin.cons x g = (Fin.cons x g : Fin (r+1) → G) := rfl
      have hr : Set.range (Fin.cons x g : Fin (r + 1) → G) = insert x (Set.range g) :=
        Fin.range_cons x g
      rw [hr, Set.insert_eq, AddSubgroup.closure_union, hg, hK', ← AddSubgroup.zmultiples_eq_closure]
      exact sup_comm _ _
    · calc 2 ^ (r + 1) = 2 * 2 ^ r := by ring
        _ ≤ 2 * Nat.card K := by omega
        _ ≤ Nat.card K' := hd

theorem exists_hasGen_log : ∃ r : ℕ, 2 ^ r ≤ Nat.card G ∧ HasGen G r :=
  chain (Nat.card G) ⊥ 0 (fun i => i.elim0) (Nat.sub_le _ _)
    (by simp) (by simp)

theorem exists_hasGen_log' [Fintype G] : HasGen G (Nat.log 2 (Fintype.card G)) := by
  obtain ⟨r, hr, hg⟩ := exists_hasGen_log (G := G)
  rw [Nat.card_eq_fintype_card] at hr
  exact hasGen_mono (Nat.le_log_of_pow_le (by norm_num) hr) hg

end ECDLP.L119
