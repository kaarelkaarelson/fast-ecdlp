/-- c1 upper bound used for e_n * c1 * 5 <= 0.2999: c1_eff = 89.01 (1 + 2^-19 * 2.3334) <= 89.0104 (ASSUMPTION R1/L145 sup bound; arithmetic only here) -/
def C1U : ℚ := 890104 / 10 ^ 4

def finB (tight : Bool) (x0 : ℕ) (sched : List (ℕ × ℚ × ℚ)) (xn : ℕ) : Bool :=
  match chainB tight x0 (1 / 2) sched with
  | none => false
  | some (x, E) => decide (x = xn) && decide (E * C1U * 5 ≤ 2999 / 10 ^ 4)

lemma finB_sound {tight : Bool} {x0 : ℕ} {sched : List (ℕ × ℚ × ℚ)} {xn : ℕ}
    (h : finB tight x0 sched xn = true) :
    ∃ En : ℚ, ChainOK tight x0 (1 / 2) sched xn En ∧ En * C1U * 5 ≤ 2999 / 10 ^ 4 := by
  unfold finB at h
  split at h
  · simp at h
  · rename_i x E hE
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨hx, hle⟩ := h
    subst hx
    exact ⟨E, chainB_sound tight sched x0 _ _ _ hE, hle⟩

lemma paper_fin : finB false 7 schedPaper 42313122 = true := by decide +kernel
lemma tight_fin : finB true 6 schedTight 38962562 = true := by decide +kernel

/-- top level: zeta_top = 2^-20, g = 2^(x_n + s_top): case-(ii) inequality zeta^2 * 2 g >= ln(2gK)
    (K = 2^x_n, written 2^(s+1) zeta^2 >= ln 2 (1 + 2 x_n + s)) -/
def TopOK (xn st : ℕ) : Prop :=
  Real.log 2 * (1 + 2 * (xn : ℝ) + st) ≤ ((1 : ℝ) / 2 ^ 20) ^ 2 * 2 ^ (st + 1)

lemma top_ok (xn : ℕ) (hx : xn = 42313122 ∨ xn = 38962562) : TopOK xn 65 := by
  unfold TopOK
  have := ln2_le
  have hq : (LN2U : ℚ) * (1 + 2 * (xn : ℚ) + 65) ≤ ((1 : ℚ) / 2 ^ 20) ^ 2 * 2 ^ 66 := by
    rcases hx with rfl | rfl <;> norm_num [LN2U]
  have hq' : (LN2U : ℝ) * (1 + 2 * (xn : ℝ) + 65) ≤ ((1 : ℝ) / 2 ^ 20) ^ 2 * 2 ^ 66 := by
    have := (Rat.cast_le (K := ℝ)).mpr hq
    push_cast at this ⊢; exact this
  have hpos : (0:ℝ) ≤ 1 + 2 * (xn : ℝ) + 65 := by positivity
  push_cast
  nlinarith

/-- s_top = 65 is minimal: every s <= 64 fails case (ii) at the top level -/
lemma top_min (xn : ℕ) (hx : xn = 42313122 ∨ xn = 38962562) (st : ℕ) (hs : st ≤ 64) : ¬ TopOK xn st := by
  unfold TopOK
  intro h
  have hl := Real.log_two_gt_d9
  have hxr : (38962562 : ℝ) ≤ xn := by rcases hx with rfl | rfl <;> norm_num
  have hp : (2:ℝ) ^ (st + 1) ≤ 2 ^ 65 := pow_le_pow_right₀ (by norm_num) (by omega)
  have : ((1 : ℝ) / 2 ^ 20) ^ 2 * 2 ^ (st + 1) ≤ ((1 : ℝ) / 2 ^ 20) ^ 2 * 2 ^ 65 :=
    mul_le_mul_of_nonneg_left hp (by positivity)
  have hst : (0:ℝ) ≤ st := by positivity
  norm_num at hl this
  nlinarith

/-- PAPER recursion ((rho+3 zeta)e + 3/K): schedule x0 = 7, 20 levels. -/
theorem G1_arith_paper :
    (∃ En : ℚ, ChainOK false 7 (1 / 2) schedPaper 42313122 En ∧ En * C1U * 5 ≤ 2999 / 10 ^ 4) ∧
    TopOK 42313122 65 ∧ (∀ s ≤ 64, ¬ TopOK 42313122 s) ∧
    4 * (42313122 + 65 + 1) = 169252752 ∧ 169252752 ≤ 2 * 10 ^ 8 :=
  ⟨finB_sound paper_fin, top_ok _ (Or.inl rfl), fun s hs => top_min _ (Or.inl rfl) s hs, by norm_num, by norm_num⟩

/-- TIGHT recursion ((rho+2 zeta+1/g)e + 2/K + c/g^4), x0 = 6, 20 levels. -/
theorem G1_arith_tight :
    (∃ En : ℚ, ChainOK true 6 (1 / 2) schedTight 38962562 En ∧ En * C1U * 5 ≤ 2999 / 10 ^ 4) ∧
    TopOK 38962562 65 ∧ (∀ s ≤ 64, ¬ TopOK 38962562 s) ∧
    4 * (38962562 + 65 + 1) = 155850512 ∧ 155850512 ≤ 2 * 10 ^ 8 :=
  ⟨finB_sound tight_fin, top_ok _ (Or.inr rfl), fun s hs => top_min _ (Or.inr rfl) s hs, by norm_num, by norm_num⟩

