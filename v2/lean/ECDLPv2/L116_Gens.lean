import Mathlib
import ECDLPv2.L116_Rank2

/-!
# L116 / Gens: a subgroup of a quotient of `ℤ^n` is generated by `n` elements
-/
set_option linter.unusedSectionVars false
set_option linter.deprecated false
namespace ECDLP.L116

open Finset

theorem hasGen_mono {A : Type*} [AddCommGroup A] {k k' : ℕ} (h : k ≤ k') (hA : HasGen A k) :
    HasGen A k' := by
  obtain ⟨g, hg⟩ := hA
  refine ⟨fun i => if h' : (i : ℕ) < k then g ⟨i, h'⟩ else 0, ?_⟩
  rw [eq_top_iff, ← hg, AddSubgroup.closure_le]
  rintro _ ⟨i, rfl⟩
  apply AddSubgroup.subset_closure
  exact ⟨⟨i, by omega⟩, by simp⟩

theorem hasGen_subgroup {n : ℕ} {V : Type*} [AddCommGroup V] (π : (Fin n → ℤ) →+ V)
    (hπ : Function.Surjective π) (K : AddSubgroup V) : HasGen K n := by
  classical
  let K' : Submodule ℤ (Fin n → ℤ) := (K.comap π).toIntSubmodule
  haveI : Module.Free ℤ K' := inferInstance
  let b := Module.Free.chooseBasis ℤ K'
  have hrank : Fintype.card (Module.Free.ChooseBasisIndex ℤ K') ≤ n := by
    have h1 := Submodule.finrank_le K'
    rw [Module.finrank_eq_card_chooseBasisIndex] at h1
    simpa using h1
  -- generators of K' as an additive group
  have hspan : AddSubgroup.closure (Set.range b) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : x ∈ Submodule.span ℤ (Set.range b) := by rw [b.span_eq]; trivial
    refine Submodule.span_induction (p := fun y _ => y ∈ AddSubgroup.closure (Set.range b))
      (fun y hy => AddSubgroup.subset_closure hy) (zero_mem _) (fun _ _ _ _ h1 h2 => add_mem h1 h2)
      (fun c y _ h => ?_) hx
    exact AddSubgroup.zsmul_mem _ h c
  let e := Fintype.equivFin (Module.Free.ChooseBasisIndex ℤ K')
  have hK' : HasGen K' (Fintype.card (Module.Free.ChooseBasisIndex ℤ K')) := by
    refine ⟨fun i => b (e.symm i), ?_⟩
    show AddSubgroup.closure (Set.range (b ∘ e.symm)) = ⊤
    rw [e.symm.surjective.range_comp]; exact hspan
  let ψ : K' →+ K := (π.comp K'.subtype.toAddMonoidHom).codRestrict K (fun x => x.2)
  have hψ : Function.Surjective ψ := by
    intro k
    obtain ⟨y, hy⟩ := hπ k.1
    refine ⟨⟨y, ?_⟩, Subtype.ext hy⟩
    show π y ∈ K
    rw [hy]; exact k.2
  exact hasGen_mono hrank (hasGen_of_surj ψ hψ hK')

end ECDLP.L116
