def finQ (x0 : ℕ) (E0 : ℚ) (sched : List (ℕ × ℚ × ℚ)) (xn : ℕ) : Bool :=
  match chainB false x0 E0 sched with
  | none => false
  | some (x, E) => decide (x = xn) && decide (E * C1U * 5 ≤ 2999 / 10 ^ 4)

lemma finQ_sound {x0 : ℕ} {E0 : ℚ} {sched : List (ℕ × ℚ × ℚ)} {xn : ℕ}
    (h : finQ x0 E0 sched xn = true) :
    ∃ En : ℚ, ChainOK false x0 E0 sched xn En ∧ En * C1U * 5 ≤ 2999 / 10 ^ 4 := by
  unfold finQ at h
  split at h
  · simp at h
  · rename_i x E hE
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨hx, hle⟩ := h
    subst hx
    exact ⟨E, chainB_sound false sched x0 _ _ _ hE, hle⟩

lemma qfree_fin : finQ 8 (129 / 512) schedQFree 10929394 = true := by decide +kernel
lemma qpaper_fin : finQ 18 (131073 / 524288) schedQPaper 15728490 = true := by decide +kernel

lemma top_ok_q (xn st : ℕ) (hq : (LN2U : ℚ) * (1 + 2 * (xn : ℚ) + st) ≤ ((1 : ℚ) / 2 ^ 20) ^ 2 * 2 ^ (st + 1)) :
    TopOK xn st := by
  unfold TopOK
  have := ln2_le
  have hq' : (LN2U : ℝ) * (1 + 2 * (xn : ℝ) + st) ≤ ((1 : ℝ) / 2 ^ 20) ^ 2 * 2 ^ (st + 1) := by
    have := (Rat.cast_le (K := ℝ)).mpr hq
    push_cast at this ⊢; exact this
  have hpos : (0:ℝ) ≤ 1 + 2 * (xn : ℝ) + st := by positivity
  nlinarith

/-- minimality of s_top: below `st0` the top-level case-(ii) inequality fails (uses log 2 > 0.6931471803). -/
lemma top_min_q (xn st0 : ℕ) (hb : (2:ℝ) ^ st0 * (1 / 2 ^ 20) ^ 2 < 0.6931471803 * (1 + 2 * (xn : ℝ)))
    (st : ℕ) (hs : st + 1 ≤ st0) : ¬ TopOK xn st := by
  unfold TopOK
  intro h
  have hl := Real.log_two_gt_d9
  have hp : (2:ℝ) ^ (st + 1) ≤ 2 ^ st0 := pow_le_pow_right₀ (by norm_num) hs
  have h1 : ((1 : ℝ) / 2 ^ 20) ^ 2 * 2 ^ (st + 1) ≤ ((1 : ℝ) / 2 ^ 20) ^ 2 * 2 ^ st0 :=
    mul_le_mul_of_nonneg_left hp (by positivity)
  have hst : (0:ℝ) ≤ st := by positivity
  have hx : (0:ℝ) ≤ xn := by positivity
  nlinarith

/-- e0 = 1/4 + 1/(2 K0), FREE zeta schedule, x0 = 8, 18 levels: crossover log2 L_c = 43,717,832. -/
theorem E0Q_arith_free :
    (∃ En : ℚ, ChainOK false 8 (129 / 512) schedQFree 10929394 En ∧ En * C1U * 5 ≤ 2999 / 10 ^ 4) ∧
    TopOK 10929394 63 ∧ (∀ s, s + 1 ≤ 63 → ¬ TopOK 10929394 s) ∧
    4 * (10929394 + 63 + 1) = 43717832 ∧ schedQFree.length = 18 :=
  ⟨finQ_sound qfree_fin, top_ok_q _ _ (by norm_num [LN2U]),
   fun s hs => top_min_q _ 63 (by norm_num) s hs, by norm_num, by decide⟩

/-- e0 = 1/4 + 1/(2 K0), PAPER schedule (x0 = 18, s_l = 3l + 18, zeta_l = 2^(-l-5)), 18 levels:
    crossover log2 L_c = 62,914,220 (4x below the paper schedule with e0 = 1/2, 251,657,860). -/
theorem E0Q_arith_paper :
    (∃ En : ℚ, ChainOK false 18 (131073 / 524288) schedQPaper 15728490 En ∧ En * C1U * 5 ≤ 2999 / 10 ^ 4) ∧
    TopOK 15728490 64 ∧ (∀ s, s + 1 ≤ 64 → ¬ TopOK 15728490 s) ∧
    4 * (15728490 + 64 + 1) = 62914220 ∧ schedQPaper.length = 18 :=
  ⟨finQ_sound qpaper_fin, top_ok_q _ _ (by norm_num [LN2U]),
   fun s hs => top_min_q _ 64 (by norm_num) s hs, by norm_num, by decide⟩

