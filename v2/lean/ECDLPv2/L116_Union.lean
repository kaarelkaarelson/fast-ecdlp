import Mathlib

/-!
# L116 / Union: generation of a finite abelian group by `s` uniform elements, union bound at one prime

For a finite abelian group `A` generated by `k` elements and a prime `ℓ`:
the number of `s`-tuples `m` of `A` for which some nonzero hom `φ : A →+ ZMod ℓ` kills every `m i`
is at most `(ℓ^k - 1) |A|^s / ((ℓ-1) ℓ^s)`.  When `A` is an `ℓ`-group, failure of generation implies
such a `φ` exists (Frattini / maximal subgroups of a nilpotent group have prime index).
-/
set_option linter.unusedSectionVars false
set_option linter.deprecated false
namespace ECDLP.L116

open Finset

/-- `A` is generated by `k` elements. -/
def HasGen (A : Type*) [AddCommGroup A] (k : ℕ) : Prop :=
  ∃ g : Fin k → A, AddSubgroup.closure (Set.range g) = ⊤

section union
variable {A : Type*} [AddCommGroup A] [Fintype A] [DecidableEq A]

open Classical in
/-- number of `s`-tuples generating `A`. -/
noncomputable def genCount (A : Type*) [AddCommGroup A] [Fintype A] (s : ℕ) : ℕ :=
  (univ.filter (fun m : Fin s → A => AddSubgroup.closure (Set.range m) = ⊤)).card

theorem hom_ext_gen {B : Type*} [AddCommGroup B] {k : ℕ} {g : Fin k → A}
    (hg : AddSubgroup.closure (Set.range g) = ⊤) {φ ψ : A →+ B} (h : ∀ i, φ (g i) = ψ (g i)) :
    φ = ψ := by
  have : AddSubgroup.closure (Set.range g) ≤ AddMonoidHom.eqLocus φ ψ :=
    (AddSubgroup.closure_le _).2 (by rintro _ ⟨i, rfl⟩; exact h i)
  rw [hg] at this
  exact AddMonoidHom.ext fun x => this (AddSubgroup.mem_top x)

theorem hom_card_le {ℓ k : ℕ} [Fact ℓ.Prime] (hA : HasGen A k) :
    Nat.card (A →+ ZMod ℓ) ≤ ℓ ^ k := by
  obtain ⟨g, hg⟩ := hA
  have hinj : Function.Injective (fun φ : A →+ ZMod ℓ => fun i => φ (g i)) := by
    intro φ ψ h
    exact hom_ext_gen hg (fun i => congrFun h i)
  have : Finite (A →+ ZMod ℓ) := Finite.of_injective _ hinj
  calc Nat.card (A →+ ZMod ℓ) ≤ Nat.card (Fin k → ZMod ℓ) := Nat.card_le_card_of_injective _ hinj
    _ = ℓ ^ k := by simp [Nat.card_eq_fintype_card]

theorem ker_card {ℓ : ℕ} [Fact ℓ.Prime] (φ : A →+ ZMod ℓ) (hφ : φ ≠ 0) :
    Fintype.card A = Nat.card φ.ker * ℓ := by
  classical
  have hsurj : Function.Surjective φ := by
    obtain ⟨x0, hx0⟩ : ∃ x0, φ x0 ≠ 0 := by
      by_contra h; push Not at h; exact hφ (AddMonoidHom.ext h)
    intro y
    refine ⟨((y / φ x0).val) • x0, ?_⟩
    rw [map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val]
    field_simp
  have := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup φ.ker
  rw [Nat.card_eq_fintype_card] at this
  have e := QuotientAddGroup.quotientKerEquivOfSurjective φ hsurj
  rw [this, Nat.card_congr e.toEquiv, Nat.card_zmod]
  simp [Nat.card_eq_fintype_card, mul_comm]

open Classical in
/-- union bound at one prime. -/
theorem union_bound {ℓ k : ℕ} [Fact ℓ.Prime] (hA : HasGen A k) (s : ℕ) :
    (univ.filter (fun m : Fin s → A => ∃ φ : A →+ ZMod ℓ, φ ≠ 0 ∧ ∀ i, φ (m i) = 0)).card
      * ((ℓ - 1) * ℓ ^ s) ≤ (ℓ ^ k - 1) * (Fintype.card A) ^ s := by
  obtain ⟨g, hg⟩ := hA
  have hinj : Function.Injective (fun φ : A →+ ZMod ℓ => fun i => φ (g i)) := by
    intro φ ψ h
    exact hom_ext_gen hg (fun i => congrFun h i)
  have : Finite (A →+ ZMod ℓ) := Finite.of_injective _ hinj
  have : Fintype (A →+ ZMod ℓ) := Fintype.ofFinite _
  set T : Finset (A →+ ZMod ℓ) := univ.erase 0 with hT
  set S : Finset (Fin s → A) :=
    univ.filter (fun m : Fin s → A => ∃ φ : A →+ ZMod ℓ, φ ≠ 0 ∧ ∀ i, φ (m i) = 0) with hS
  have hTc : T.card ≤ ℓ ^ k - 1 := by
    have h1 : T.card + 1 = Fintype.card (A →+ ZMod ℓ) := by
      rw [hT, Finset.card_erase_add_one (mem_univ _), Finset.card_univ]
    have h2 : Fintype.card (A →+ ZMod ℓ) ≤ ℓ ^ k := by
      have := hom_card_le (ℓ := ℓ) ⟨g, hg⟩
      rwa [Nat.card_eq_fintype_card] at this
    omega
  have key : S.card * (ℓ - 1) ≤ T.card * (Fintype.card A / ℓ) ^ s := by
    refine Finset.card_mul_le_card_mul (fun m φ => ∀ i, φ (m i) = 0) ?_ ?_
    · intro m hm
      rw [hS, mem_filter] at hm
      obtain ⟨_, φ0, h0, hm0⟩ := hm
      have hpos : 0 < ℓ := (Fact.out : ℓ.Prime).pos
      -- c ↦ c * φ0 injective from units
      have hinj2 : Function.Injective (fun c : (ZMod ℓ)ˣ =>
          ((AddMonoidHom.mulLeft (c : ZMod ℓ)).comp φ0 : A →+ ZMod ℓ)) := by
        intro c c' h
        obtain ⟨x0, hx0⟩ : ∃ x0, φ0 x0 ≠ 0 := by
          by_contra h'; push Not at h'; exact h0 (AddMonoidHom.ext h')
        have := congrArg (fun f : A →+ ZMod ℓ => f x0) h
        simp only [AddMonoidHom.comp_apply, AddMonoidHom.coe_mulLeft] at this
        exact Units.ext (mul_right_cancel₀ hx0 this)
      have : Fintype.card (ZMod ℓ)ˣ ≤ (T.bipartiteAbove (fun m φ => ∀ i, φ (m i) = 0) m).card := by
        refine Finset.card_le_card_of_injOn
          (fun c : (ZMod ℓ)ˣ => ((AddMonoidHom.mulLeft (c : ZMod ℓ)).comp φ0 : A →+ ZMod ℓ))
          (fun c _ => ?_) (fun c _ c' _ h => hinj2 h)
        simp only [Finset.mem_coe, Finset.mem_univ] at *
        rw [Finset.mem_bipartiteAbove, hT, mem_erase]
        refine ⟨⟨?_, mem_univ _⟩, ?_⟩
        · intro hz
          obtain ⟨x0, hx0⟩ : ∃ x0, φ0 x0 ≠ 0 := by
            by_contra h'; push Not at h'; exact h0 (AddMonoidHom.ext h')
          have := congrArg (fun f : A →+ ZMod ℓ => f x0) hz
          simp only [AddMonoidHom.comp_apply, AddMonoidHom.coe_mulLeft, AddMonoidHom.zero_apply] at this
          exact (mul_ne_zero c.ne_zero hx0) this
        · intro i
          simp [hm0 i]
      rwa [ZMod.card_units] at this
    · intro φ hφ
      rw [hT, mem_erase] at hφ
      have hker := ker_card φ hφ.1
      have hℓ : 0 < ℓ := (Fact.out : ℓ.Prime).pos
      have hc : Fintype.card A / ℓ = Nat.card φ.ker := by
        rw [hker]; exact Nat.mul_div_cancel _ hℓ
      calc (S.bipartiteBelow (fun m φ => ∀ i, φ (m i) = 0) φ).card
          ≤ (Fintype.piFinset (fun _ : Fin s => (univ.filter (fun x : A => φ x = 0)))).card := by
            refine Finset.card_le_card (fun m hm => ?_)
            rw [Finset.mem_bipartiteBelow] at hm
            rw [Fintype.mem_piFinset]
            intro i; simp [hm.2 i]
        _ = (Fintype.card A / ℓ) ^ s := by
            rw [Fintype.card_piFinset, hc]
            simp only [prod_const, card_univ, Fintype.card_fin]
            congr 1
            rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
            congr 1
  convert (show S.card * ((ℓ - 1) * ℓ ^ s) ≤ (ℓ ^ k - 1) * (Fintype.card A) ^ s from ?_)
  calc S.card * ((ℓ - 1) * ℓ ^ s) = (S.card * (ℓ - 1)) * ℓ ^ s := by ring
    _ ≤ (T.card * (Fintype.card A / ℓ) ^ s) * ℓ ^ s := Nat.mul_le_mul_right _ key
    _ = T.card * ((Fintype.card A / ℓ) * ℓ) ^ s := by rw [mul_assoc, ← mul_pow]
    _ ≤ T.card * (Fintype.card A) ^ s :=
        Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (Nat.div_mul_le_self _ _) _)
    _ ≤ (ℓ ^ k - 1) * (Fintype.card A) ^ s := Nat.mul_le_mul_right _ hTc

end union
end ECDLP.L116
