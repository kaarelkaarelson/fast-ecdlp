import Mathlib
import ECDLPv2.L114_Round
import ECDLPv2.L116_Cor
import ECDLPv2.L116_Gens

/-!
# L116 / Main: Lemma gen discharged.

* `genBound_primePow`: L114's `GenBound` hypothesis for any subgroup `K ≤ (Z/ℓ^v)^4` with `D = ℓ^(s-3)/2`
  (paper Lemma `gen`: failure probability `≤ 2 ℓ^{3-s}`).
* `gen_two_explicit`: two uniform elements generate a finite abelian group `A` generated by two elements
  (e.g. `E(F_p)`) with probability at least `(5/16) φ(|A|)/|A|`; `gen_two_prod`: at least `∏_{ℓ | |A|} (1 - (ℓ+1)/ℓ²)`.
-/
set_option linter.unusedSectionVars false
set_option linter.deprecated false
namespace ECDLP.L116

open Finset

/-- **Lemma gen, rank ≤ 2, product form.** -/
theorem gen_two_prod {A : Type*} [AddCommGroup A] [Fintype A] (hA : HasGen A 2) :
    ∏ ℓ ∈ (Fintype.card A).primeFactors, pf ℓ ≤ (genCount A 2 : ℚ) / (Fintype.card A : ℚ) ^ 2 :=
  gen_two_prob _ A rfl hA

/-- **Lemma gen, rank ≤ 2, explicit.**  `P(two uniform elements generate A) ≥ (5/16) φ(|A|)/|A|`. -/
theorem gen_two_explicit {A : Type*} [AddCommGroup A] [Fintype A] (hA : HasGen A 2) :
    (5 / 16 : ℚ) * ((Nat.totient (Fintype.card A) : ℚ) / (Fintype.card A : ℚ)) ≤
      (genCount A 2 : ℚ) / (Fintype.card A : ℚ) ^ 2 := by
  set N := Fintype.card A with hN
  have hN0 : (N : ℚ) ≠ 0 := by rw [hN]; exact_mod_cast Fintype.card_ne_zero
  have hprime : ∀ ℓ ∈ N.primeFactors, ℓ.Prime := fun ℓ hℓ => Nat.prime_of_mem_primeFactors hℓ
  have h1 := gen_two_prod hA
  have h2 : ∏ ℓ ∈ N.primeFactors, pf ℓ =
      (∏ ℓ ∈ N.primeFactors, (1 - ((ℓ : ℚ))⁻¹)) * ∏ ℓ ∈ N.primeFactors, gq ℓ := by
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl fun ℓ hℓ => pf_eq (hprime ℓ hℓ).two_le
  have h3 := prod_gq_ge N.primeFactors hprime
  have h4 : 0 ≤ ∏ ℓ ∈ N.primeFactors, (1 - ((ℓ : ℚ))⁻¹) := Finset.prod_nonneg fun ℓ hℓ => by
    have : (2 : ℚ) ≤ ℓ := by exact_mod_cast (hprime ℓ hℓ).two_le
    have : ((ℓ : ℚ))⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by linarith)
    linarith
  have h5 : (Nat.totient N : ℚ) / (N : ℚ) = ∏ ℓ ∈ N.primeFactors, (1 - ((ℓ : ℚ))⁻¹) := by
    rw [Nat.totient_eq_mul_prod_factors]; field_simp
  rw [h5]
  refine le_trans ?_ h1
  rw [h2]
  nlinarith

section hs
open ECDLP.L114
variable {G : Type*} [AddCommGroup G] {N k : ℕ} [NeZero N]

/-- **`hsurj` from generation.**  If the base points generate `G`, tag evaluation is surjective. -/
theorem evG_surjective_of_closure (V : Fin k → G) (hN : ∀ g : G, N • g = 0)
    (h : AddSubgroup.closure (Set.range V) = ⊤) : Function.Surjective (evG V hN) := by
  have hle : AddSubgroup.closure (Set.range V) ≤ (evG V hN).range := by
    rw [AddSubgroup.closure_le]
    rintro _ ⟨j, rfl⟩
    refine ⟨fun i => (((Pi.single j (1 : ℤ) : Fin k → ℤ) i : ℤ) : ZMod N), ?_⟩
    rw [evG, evHom_intCast]
    simp [Finset.sum_apply, Pi.single_apply]
  rw [h] at hle
  intro g
  exact hle (AddSubgroup.mem_top g)

theorem hsurj_of_pair (H1 H2 P Q : G) (hN : ∀ g : G, N • g = 0)
    (h : AddSubgroup.closure (Set.range ![H1, H2]) = ⊤) :
    Function.Surjective (evG ![H1, H2, P, Q] hN) := by
  apply evG_surjective_of_closure
  rw [eq_top_iff, ← h, AddSubgroup.closure_le]
  rintro _ ⟨i, rfl⟩
  apply AddSubgroup.subset_closure
  fin_cases i
  · exact ⟨0, rfl⟩
  · exact ⟨1, rfl⟩

end hs

section genbound
variable {q : ℕ} [NeZero q]

theorem hasGen_four (K : AddSubgroup (Fin 4 → ZMod q)) : HasGen K 4 := by
  refine hasGen_subgroup ((Int.castAddHom (ZMod q)).compLeft (Fin 4)) ?_ K
  intro y
  exact ⟨fun i => ((y i).val : ℤ), by funext i; simp⟩

open Classical in
theorem closure_range_sub_iff {s : ℕ} (K : AddSubgroup (Fin 4 → ZMod q)) (m : Fin s → K) :
    AddSubgroup.closure (Set.range (fun i => (m i : Fin 4 → ZMod q))) = K ↔
      AddSubgroup.closure (Set.range m) = ⊤ := by
  have h : AddSubgroup.map K.subtype (AddSubgroup.closure (Set.range m)) =
      AddSubgroup.closure (Set.range (fun i => (m i : Fin 4 → ZMod q))) := by
    rw [AddMonoidHom.map_closure, ← Set.range_comp]; rfl
  rw [← h]
  constructor
  · intro h1
    have := congrArg (AddSubgroup.comap K.subtype) h1
    rw [AddSubgroup.comap_map_eq_self_of_injective K.subtype_injective] at this
    rw [this]
    exact eq_top_iff.2 fun x _ => x.2
  · intro h1; rw [h1, ← AddMonoidHom.range_eq_map]; exact K.range_subtype

open Classical in
/-- **L114's `GenBound` discharged.** -/
theorem genBound_primePow {ℓ v : ℕ} [Fact ℓ.Prime] (hq : q = ℓ ^ v)
    (K : AddSubgroup (Fin 4 → ZMod q)) (s : ℕ) : ECDLP.L114.GenBound q K s (ℓ ^ (s - 3) / 2) := by
  classical
  unfold ECDLP.L114.GenBound
  have hK : Fintype.card K ∣ ℓ ^ (4 * v) := by
    have h1 : Fintype.card K ∣ Fintype.card (Fin 4 → ZMod q) := by
      rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card]
      exact AddSubgroup.card_addSubgroup_dvd_card K
    have h2 : Fintype.card (Fin 4 → ZMod q) = ℓ ^ (4 * v) := by
      simp [ZMod.card, hq, pow_mul]
      ring
    rwa [h2] at h1
  obtain ⟨a, -, ha⟩ := (Nat.dvd_prime_pow (Fact.out : ℓ.Prime)).1 hK
  have hb := pgroup_fail_bound (A := K) (ℓ := ℓ) (k := 4) (a := a) ha (hasGen_four K) s
  have hle := genCount_le (A := K) s
  -- translate the ambient failure count into the subtype failure count
  set Fl := (Fintype.piFinset (fun _ : Fin s => (univ.filter (fun x : Fin 4 → ZMod q => x ∈ K)))).filter
    (fun m => ¬ AddSubgroup.closure (Set.range m) = K) with hFl
  have hcard : Fl.card = (Fintype.card K) ^ s - genCount K s := by
    have himg : Fl = (univ.filter (fun m' : Fin s → K => ¬ AddSubgroup.closure (Set.range m') = ⊤)).image
        (fun m' => fun i => (m' i : Fin 4 → ZMod q)) := by
      ext m
      simp only [hFl, mem_filter, Fintype.mem_piFinset, mem_univ, true_and, mem_image]
      constructor
      · rintro ⟨hm, hn⟩
        refine ⟨fun i => ⟨m i, hm i⟩, ?_, rfl⟩
        rw [← closure_range_sub_iff K]; exact hn
      · rintro ⟨m', hn, rfl⟩
        refine ⟨fun i => (m' i).2, ?_⟩
        rw [closure_range_sub_iff K]; exact hn
    rw [himg, Finset.card_image_of_injective _ (fun a b h => funext fun i => Subtype.ext (congrFun h i))]
    have h1 : genCount K s + (univ.filter (fun m : Fin s → K => ¬ AddSubgroup.closure (Set.range m) = ⊤)).card
        = (Fintype.card K) ^ s := by
      unfold genCount
      rw [Finset.card_filter_add_card_filter_not (s := (univ : Finset (Fin s → K)))]
      simp
    omega
  rw [hcard]
  have hℓ := (Fact.out : ℓ.Prime)
  by_cases hs : s < 3
  · have : ℓ ^ (s - 3) = 1 := by simp [Nat.sub_eq_zero_of_le hs.le]
    rw [this]; simp
  · push Not at hs
    set Nk := Fintype.card K
    set f := Nk ^ s - genCount K s
    have e1 : f * (ℓ ^ s) ≤ 2 * ℓ ^ 3 * Nk ^ s := by
      have h3 : f * ((ℓ - 1) * ℓ ^ s) ≤ (ℓ ^ 4 - 1) * Nk ^ s := hb
      -- (ℓ^4 - 1) = (ℓ - 1)(ℓ^3+ℓ^2+ℓ+1) ≤ (ℓ-1) 2 ℓ^3
      have hℓ2 := hℓ.two_le
      have h4 : ℓ ^ 4 - 1 ≤ (ℓ - 1) * (2 * ℓ ^ 3) := by
        obtain ⟨t, rfl⟩ : ∃ t, ℓ = t + 2 := ⟨ℓ - 2, by omega⟩
        simp only [show t + 2 - 1 = t + 1 by omega]
        have : (t + 2) ^ 4 = 1 + (t + 1) * ((t + 2) ^ 3 + (t + 2) ^ 2 + (t + 2) + 1) := by ring
        rw [this, Nat.add_sub_cancel_left]
        apply Nat.mul_le_mul_left
        nlinarith [Nat.zero_le t]
      have h5 : f * ((ℓ - 1) * ℓ ^ s) ≤ ((ℓ - 1) * (2 * ℓ ^ 3)) * Nk ^ s :=
        h3.trans (Nat.mul_le_mul_right _ h4)
      have hpos : 0 < ℓ - 1 := by omega
      have : (ℓ - 1) * (f * ℓ ^ s) ≤ (ℓ - 1) * (2 * ℓ ^ 3 * Nk ^ s) := by nlinarith
      exact Nat.le_of_mul_le_mul_left this hpos
    have e2 : f * ℓ ^ (s - 3) ≤ 2 * Nk ^ s := by
      have : ℓ ^ s = ℓ ^ (s - 3) * ℓ ^ 3 := by rw [← pow_add]; congr 1; omega
      rw [this] at e1
      have hpos : 0 < ℓ ^ 3 := pow_pos hℓ.pos 3
      have : (f * ℓ ^ (s - 3)) * ℓ ^ 3 ≤ (2 * Nk ^ s) * ℓ ^ 3 := by nlinarith
      exact Nat.le_of_mul_le_mul_right this hpos
    calc f * (ℓ ^ (s - 3) / 2) ≤ f * ℓ ^ (s - 3) / 2 := Nat.mul_div_le_mul_div_assoc _ _ _
      _ ≤ Nk ^ s := by
        apply Nat.div_le_of_le_mul; omega

end genbound
end ECDLP.L116
