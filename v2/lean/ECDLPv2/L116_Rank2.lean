import Mathlib
import ECDLPv2.L116_Split

/-!
# L116 / Rank2: two uniform elements generate a finite abelian group of rank ≤ 2 with probability
`≥ ∏_{ℓ | |A|} (1 - (ℓ+1)/ℓ²)`.
-/
set_option linter.unusedSectionVars false
set_option linter.deprecated false
namespace ECDLP.L116

open Finset

/-- the one-prime factor. -/
def pf (ℓ : ℕ) : ℚ := 1 - ((ℓ : ℚ) + 1) / (ℓ : ℚ) ^ 2

theorem pf_nonneg {ℓ : ℕ} (h : 2 ≤ ℓ) : 0 ≤ pf ℓ := by
  unfold pf
  have : (2 : ℚ) ≤ ℓ := by exact_mod_cast h
  have hp : (0 : ℚ) < (ℓ : ℚ) ^ 2 := by positivity
  rw [sub_nonneg, div_le_one hp]
  nlinarith

/-- an `ℓ`-group of rank ≤ 2 (card `ℓ^a`): `P(2 uniform elements generate) ≥ pf ℓ`. -/
theorem pgroup_two {A : Type*} [AddCommGroup A] [Fintype A] {ℓ a : ℕ} [Fact ℓ.Prime]
    (hcard : Fintype.card A = ℓ ^ a) (hA : HasGen A 2) :
    pf ℓ ≤ (genCount A 2 : ℚ) / (Fintype.card A : ℚ) ^ 2 := by
  classical
  have hb := pgroup_fail_bound (A := A) (ℓ := ℓ) (k := 2) (a := a) hcard hA 2
  have hle := genCount_le (A := A) 2
  have hℓ : (2 : ℕ) ≤ ℓ := (Fact.out : ℓ.Prime).two_le
  have hℓq : (2 : ℚ) ≤ ℓ := by exact_mod_cast hℓ
  set N := Fintype.card A with hN
  have hNpos : 0 < N := Fintype.card_pos
  have hq : (((N : ℚ) ^ 2 - genCount A 2) * (((ℓ : ℚ) - 1) * (ℓ : ℚ) ^ 2)) ≤ ((ℓ : ℚ) ^ 2 - 1) * (N : ℚ) ^ 2 := by
    have h1 := (Nat.cast_le (α := ℚ)).2 hb
    have e1 : (1 : ℕ) ≤ ℓ := by omega
    have e2 : (1 : ℕ) ≤ ℓ ^ 2 := Nat.one_le_pow _ _ (by omega)
    push_cast [Nat.cast_sub hle, Nat.cast_sub e1, Nat.cast_sub e2] at h1
    exact h1
  have hX : (0 : ℚ) < (N : ℚ) ^ 2 := by positivity
  unfold pf
  rw [le_div_iff₀ hX]
  have hl1 : (0 : ℚ) < (ℓ : ℚ) - 1 := by linarith
  have h2 : ((N : ℚ) ^ 2 - genCount A 2) * (ℓ : ℚ) ^ 2 ≤ ((ℓ : ℚ) + 1) * (N : ℚ) ^ 2 := by
    have : (((N : ℚ) ^ 2 - genCount A 2) * (ℓ : ℚ) ^ 2) * ((ℓ : ℚ) - 1) ≤ (((ℓ : ℚ) + 1) * (N : ℚ) ^ 2) * ((ℓ : ℚ) - 1) := by
      nlinarith
    exact le_of_mul_le_mul_right this hl1
  have hl2 : (0 : ℚ) < (ℓ : ℚ) ^ 2 := by positivity
  have h3 : (N : ℚ) ^ 2 - genCount A 2 ≤ ((ℓ : ℚ) + 1) * (N : ℚ) ^ 2 / (ℓ : ℚ) ^ 2 := by
    rw [le_div_iff₀ hl2]; exact h2
  calc (1 - ((ℓ : ℚ) + 1) / (ℓ : ℚ) ^ 2) * (N : ℚ) ^ 2
      = (N : ℚ) ^ 2 - ((ℓ : ℚ) + 1) * (N : ℚ) ^ 2 / (ℓ : ℚ) ^ 2 := by ring
    _ ≤ ((genCount A 2 : ℕ) : ℚ) := by linarith


/-- **Lemma gen, rank ≤ 2, two elements.**  For a finite abelian group `A` generated by two elements,
the probability that two independent uniform elements generate `A` is at least
`∏_{ℓ | |A|} (1 - (ℓ+1)/ℓ²)`. -/
theorem gen_two_prob : ∀ (N : ℕ) (A : Type u_1) [AddCommGroup A] [Fintype A],
    Fintype.card A = N → HasGen A 2 →
    ∏ ℓ ∈ N.primeFactors, pf ℓ ≤ (genCount A 2 : ℚ) / (N : ℚ) ^ 2 := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
  intro A _ _ hN hA
  classical
  have hN0 : N ≠ 0 := by rw [← hN]; exact Fintype.card_ne_zero
  by_cases hN1 : N = 1
  · subst hN1
    have hsub : Subsingleton A := Fintype.card_le_one_iff_subsingleton.1 hN.le
    have : genCount A 2 = 1 := by
      have h1 := genCount_le (A := A) 2
      have h2 : genCount A 2 ≠ 0 := by
        unfold genCount
        rw [← Nat.pos_iff_ne_zero, Finset.card_pos]
        refine ⟨fun _ => 0, ?_⟩
        simp only [mem_filter, mem_univ, true_and]
        exact eq_top_iff.2 fun x _ => by rw [Subsingleton.elim x 0]; exact zero_mem _
      rw [hN] at h1; simp at h1; omega
    simp [this]
  · have hℓ : (N.minFac).Prime := Nat.minFac_prime hN1
    set ℓ := N.minFac with hℓdef
    haveI : Fact ℓ.Prime := ⟨hℓ⟩
    set a := N.factorization ℓ with ha
    set n1 := ℓ ^ a with hn1
    set n2 := N / n1 with hn2
    have hdvd : n1 ∣ N := Nat.ordProj_dvd N ℓ
    have h12 : n1 * n2 = N := Nat.mul_div_cancel' hdvd
    have hcop1 : Nat.Coprime ℓ n2 := Nat.coprime_ordCompl hℓ hN0
    have hc : Nat.Coprime n1 n2 := hcop1.pow_left a
    have h0 : ∀ x : A, (n1 * n2) • x = 0 := by
      intro x; rw [h12, ← hN]; exact card_nsmul_eq_zero
    let e := splitEquiv (A := A) n1 n2 hc h0
    set A1 := ↥(nsmulAddMonoidHom (α := A) n1).ker with hA1
    set A2 := ↥(nsmulAddMonoidHom (α := A) n2).ker with hA2
    have hcardA : Fintype.card A1 * Fintype.card A2 = N := by
      rw [← hN, ← Fintype.card_prod]; exact Fintype.card_congr e.toEquiv
    have hA1pos : 0 < Fintype.card A1 := Fintype.card_pos
    have hA2pos : 0 < Fintype.card A2 := Fintype.card_pos
    -- A1 is an ℓ-group
    have hq1 : ∀ q : ℕ, q.Prime → q ∣ Fintype.card A1 → q = ℓ := by
      intro q hq hqd
      haveI : Fact q.Prime := ⟨hq⟩
      obtain ⟨x, hx⟩ := exists_prime_addOrderOf_dvd_card q hqd
      have hx0 : n1 • x = 0 := by
        have h : n1 • (x : A) = 0 := x.2
        exact Subtype.ext h
      have : q ∣ n1 := hx ▸ addOrderOf_dvd_of_nsmul_eq_zero hx0
      exact (Nat.prime_dvd_prime_iff_eq hq hℓ).1 (hq.dvd_of_dvd_pow this)
    obtain ⟨b, hc1⟩ : ∃ b, Fintype.card A1 = ℓ ^ b :=
      ⟨_, Nat.eq_prime_pow_of_unique_prime_dvd hA1pos.ne' (fun {d} hd hdd => hq1 d hd hdd)⟩
    have hnd2 : ¬ ℓ ∣ Fintype.card A2 := by
      intro hd
      obtain ⟨x, hx⟩ := exists_prime_addOrderOf_dvd_card ℓ hd
      have hx0 : n2 • x = 0 := by
        have h : n2 • (x : A) = 0 := x.2
        exact Subtype.ext h
      have : ℓ ∣ n2 := hx ▸ addOrderOf_dvd_of_nsmul_eq_zero hx0
      have := Nat.Coprime.eq_one_of_dvd hcop1 this
      exact hℓ.one_lt.ne' this
    have hb1 : b ≠ 0 := by
      intro hb0
      rw [hb0, pow_zero] at hc1
      rw [hc1, one_mul] at hcardA
      exact hnd2 (hcardA ▸ Nat.minFac_dvd N)
    have hlt : Fintype.card A2 < N := by
      have : 2 ≤ Fintype.card A1 := by
        rw [hc1]; calc 2 ≤ ℓ := hℓ.two_le
          _ ≤ ℓ ^ b := Nat.le_self_pow hb1 ℓ
      nlinarith
    have hgen1 : HasGen A1 2 := hasGen_of_surj (AddMonoidHom.fst A1 A2)
      Prod.fst_surjective (hasGen_of_equiv e.symm hA)
    have hgen2 : HasGen A2 2 := hasGen_of_surj (AddMonoidHom.snd A1 A2)
      Prod.snd_surjective (hasGen_of_equiv e.symm hA)
    have hP1 := pgroup_two (A := A1) (ℓ := ℓ) (a := b) hc1 hgen1
    have hP2 := ih _ hlt A2 rfl hgen2
    have hcopA : Nat.Coprime (Fintype.card A1) (Fintype.card A2) := by
      rw [hc1]; exact (Nat.Coprime.pow_left _ ((Nat.Prime.coprime_iff_not_dvd hℓ).2 hnd2))
    have hgen : genCount A 2 = genCount A1 2 * genCount A2 2 := by
      rw [← genCount_equiv e 2]; exact genCount_prod hcopA 2
    have hpf : N.primeFactors = insert ℓ (Fintype.card A2).primeFactors := by
      rw [← hcardA, Nat.primeFactors_mul hA1pos.ne' hA2pos.ne', hc1, Nat.primeFactors_prime_pow hb1 hℓ]
      rfl
    have hnot : ℓ ∉ (Fintype.card A2).primeFactors := by
      intro h; exact hnd2 (Nat.dvd_of_mem_primeFactors h)
    rw [hpf, Finset.prod_insert hnot, hgen]
    have hN2 : (N : ℚ) ^ 2 = (Fintype.card A1 : ℚ) ^ 2 * (Fintype.card A2 : ℚ) ^ 2 := by
      rw [← hcardA]; push_cast; ring
    rw [hN2, Nat.cast_mul, mul_div_mul_comm]
    exact mul_le_mul hP1 hP2 (Finset.prod_nonneg fun q hq => pf_nonneg (Nat.prime_of_mem_primeFactors hq).two_le)
      (div_nonneg (by positivity) (by positivity))

end ECDLP.L116
