import Mathlib
import ECDLPv2.L116_Union
import ECDLPv2.L116_Frat
import ECDLPv2.L116_Prod

/-!
# L116 / Split: failure bound for an `ℓ`-group, equivariance, and the coprime splitting `A ≃ ker n₁ × ker n₂`
-/
set_option linter.unusedSectionVars false
set_option linter.deprecated false
namespace ECDLP.L116

open Finset

section pg
variable {A : Type*} [AddCommGroup A] [Fintype A] [DecidableEq A]

theorem genCount_le (s : ℕ) : genCount A s ≤ (Fintype.card A) ^ s := by
  classical
  unfold genCount
  calc _ ≤ (univ : Finset (Fin s → A)).card := Finset.card_le_univ _
    _ = _ := by simp

/-- **Failure bound for an `ℓ`-group generated by `k` elements.** -/
theorem pgroup_fail_bound {ℓ k a : ℕ} [Fact ℓ.Prime] (hcard : Fintype.card A = ℓ ^ a)
    (hA : HasGen A k) (s : ℕ) :
    ((Fintype.card A) ^ s - genCount A s) * ((ℓ - 1) * ℓ ^ s) ≤ (ℓ ^ k - 1) * (Fintype.card A) ^ s := by
  classical
  refine le_trans (Nat.mul_le_mul_right _ ?_) (union_bound (A := A) (ℓ := ℓ) hA s)
  have h1 : genCount A s + (univ.filter (fun m : Fin s → A => ¬ AddSubgroup.closure (Set.range m) = ⊤)).card
      = (Fintype.card A) ^ s := by
    unfold genCount
    rw [Finset.card_filter_add_card_filter_not (s := (univ : Finset (Fin s → A)))]
    simp
  have h2 : (univ.filter (fun m : Fin s → A => ¬ AddSubgroup.closure (Set.range m) = ⊤)).card ≤
      (univ.filter (fun m : Fin s → A => ∃ φ : A →+ ZMod ℓ, φ ≠ 0 ∧ ∀ i, φ (m i) = 0)).card := by
    refine Finset.card_le_card (fun m hm => ?_)
    rw [mem_filter] at hm ⊢
    refine ⟨mem_univ _, ?_⟩
    obtain ⟨φ, h0, hφ⟩ := exists_hom_of_ne_top (A := A) (ℓ := ℓ) (a := a)
      (by rw [Nat.card_eq_fintype_card]; exact hcard) _ hm.2
    exact ⟨φ, h0, fun i => hφ _ (AddSubgroup.subset_closure ⟨i, rfl⟩)⟩
  omega

end pg

section equiv
variable {A A' : Type*} [AddCommGroup A] [AddCommGroup A']

theorem hasGen_of_equiv {k : ℕ} (e : A ≃+ A') (h : HasGen A k) : HasGen A' k := by
  obtain ⟨g, hg⟩ := h
  refine ⟨fun i => e (g i), ?_⟩
  have : AddSubgroup.map e.toAddMonoidHom (AddSubgroup.closure (Set.range g)) =
      AddSubgroup.closure (Set.range (fun i => e (g i))) := by
    rw [AddMonoidHom.map_closure, ← Set.range_comp]; rfl
  rw [← this, hg]
  exact AddSubgroup.map_top_of_surjective _ e.surjective

theorem hasGen_of_surj {k : ℕ} (f : A →+ A') (hf : Function.Surjective f) (h : HasGen A k) :
    HasGen A' k := by
  obtain ⟨g, hg⟩ := h
  refine ⟨fun i => f (g i), ?_⟩
  have : AddSubgroup.map f (AddSubgroup.closure (Set.range g)) =
      AddSubgroup.closure (Set.range (fun i => f (g i))) := by
    rw [AddMonoidHom.map_closure, ← Set.range_comp]; rfl
  rw [← this, hg]
  exact AddSubgroup.map_top_of_surjective _ hf

theorem closure_equiv_iff (e : A ≃+ A') {s : ℕ} (m : Fin s → A) :
    AddSubgroup.closure (Set.range (fun i => e (m i))) = ⊤ ↔ AddSubgroup.closure (Set.range m) = ⊤ := by
  have : AddSubgroup.map e.toAddMonoidHom (AddSubgroup.closure (Set.range m)) =
      AddSubgroup.closure (Set.range (fun i => e (m i))) := by
    rw [AddMonoidHom.map_closure, ← Set.range_comp]; rfl
  rw [← this]
  constructor
  · intro h
    have := congrArg (AddSubgroup.comap e.toAddMonoidHom) h
    rwa [AddSubgroup.comap_map_eq_self_of_injective e.injective, AddSubgroup.comap_top] at this
  · intro h; rw [h]; exact AddSubgroup.map_top_of_surjective _ e.surjective

open Classical in
theorem genCount_equiv [Fintype A] [Fintype A'] (e : A ≃+ A') (s : ℕ) : genCount A s = genCount A' s := by
  unfold genCount
  refine Finset.card_nbij' (fun m => fun i => e (m i)) (fun m => fun i => e.symm (m i)) ?_ ?_ ?_ ?_
  · intro m hm
    simp only [coe_filter, mem_univ, true_and, Set.mem_setOf_eq] at hm ⊢
    exact (closure_equiv_iff e m).2 hm
  · intro m hm
    simp only [coe_filter, mem_univ, true_and, Set.mem_setOf_eq] at hm ⊢
    exact (closure_equiv_iff e.symm m).2 hm
  · intro m _; funext i; simp
  · intro m _; funext i; simp

end equiv

section split
variable {A : Type*} [AddCommGroup A] [Fintype A]

/-- coprime splitting `ker n₁ × ker n₂ ≃ A` when `n₁ n₂` kills `A`. -/
noncomputable def splitEquiv (n1 n2 : ℕ) (hc : Nat.Coprime n1 n2) (h0 : ∀ x : A, (n1 * n2) • x = 0) :
    (↥(nsmulAddMonoidHom (α := A) n1).ker × ↥(nsmulAddMonoidHom (α := A) n2).ker) ≃+ A :=
  AddEquiv.ofBijective
    ((((nsmulAddMonoidHom (α := A) n1).ker.subtype).coprod
      ((nsmulAddMonoidHom (α := A) n2).ker.subtype)))
    (by
      have hBC : IsCoprime (n1 : ℤ) (n2 : ℤ) := Nat.isCoprime_iff_coprime.2 hc
      obtain ⟨u, v, huv⟩ := hBC
      constructor
      · rintro ⟨⟨x, hx⟩, ⟨y, hy⟩⟩ ⟨⟨x', hx'⟩, ⟨y', hy'⟩⟩ h
        simp only [AddMonoidHom.mem_ker, nsmulAddMonoidHom_apply] at hx hy hx' hy'
        simp only [AddMonoidHom.coprod_apply, AddSubgroup.coe_subtype] at h
        -- x - x' = y' - y killed by n1 and n2
        have hz : x - x' = y' - y := by
          have : x + y = x' + y' := h
          rw [sub_eq_sub_iff_add_eq_add, this]; exact add_comm _ _
        have h1 : n1 • (x - x') = 0 := by rw [smul_sub, hx, hx']; simp
        have h2 : n2 • (x - x') = 0 := by rw [hz, smul_sub, hy, hy']; simp
        have h3 : x - x' = 0 := by
          have : x - x' = (u * n1 + v * n2 : ℤ) • (x - x') := by rw [huv]; simp
          have h1' : (n1 : ℤ) • (x - x') = 0 := by rw [natCast_zsmul]; exact h1
          have h2' : (n2 : ℤ) • (x - x') = 0 := by rw [natCast_zsmul]; exact h2
          rw [this, add_smul, mul_smul, mul_smul, h1', h2']; simp
        have hxx : x = x' := sub_eq_zero.1 h3
        subst hxx
        have : y = y' := by simpa using h
        subst this; rfl
      · intro z
        refine ⟨(⟨(v * n2 : ℤ) • z, ?_⟩, ⟨(u * n1 : ℤ) • z, ?_⟩), ?_⟩
        · simp only [AddMonoidHom.mem_ker, nsmulAddMonoidHom_apply]
          rw [← natCast_zsmul, ← mul_smul, show ((n1 : ℤ) * (v * n2)) = v * ((n1 * n2 : ℕ) : ℤ) by push_cast; ring,
            mul_smul, natCast_zsmul, h0]; simp
        · simp only [AddMonoidHom.mem_ker, nsmulAddMonoidHom_apply]
          rw [← natCast_zsmul, ← mul_smul, show ((n2 : ℤ) * (u * n1)) = u * ((n1 * n2 : ℕ) : ℤ) by push_cast; ring,
            mul_smul, natCast_zsmul, h0]; simp
        · simp only [AddMonoidHom.coprod_apply, AddSubgroup.coe_subtype]
          rw [add_comm, ← add_smul, huv]; simp)

end split
end ECDLP.L116
