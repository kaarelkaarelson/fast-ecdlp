import Mathlib
import ECDLPv2.L116_Cor
import ECDLPv2.L116_Gens
import ECDLPv2.L119_Log

/-!
# L119 / Gen: Lemma gen for groups generated by `k` elements, `s ≥ k` uniform elements

`gen_k_prob`: if `A` is a finite abelian group generated by `k` elements and `k ≤ s`, then the probability
that `s` independent uniform elements generate `A` is at least `∏_{ℓ | |A|} (1 - (ℓ^k-1)/((ℓ-1)ℓ^s))`.
`gen_k_explicit`: for `s ≥ k+1` it is at least `5/16` (no `φ(|A|)/|A|` loss).
-/
set_option linter.unusedSectionVars false
set_option linter.deprecated false
namespace ECDLP.L119

open Finset ECDLP.L116

/-- the one-prime factor. -/
def pfk (ℓ k s : ℕ) : ℚ := 1 - ((ℓ : ℚ) ^ k - 1) / (((ℓ : ℚ) - 1) * (ℓ : ℚ) ^ s)

theorem pfk_nonneg {ℓ k s : ℕ} (hks : k ≤ s) (h : 2 ≤ ℓ) : 0 ≤ pfk ℓ k s := by
  unfold pfk
  have h2 : (2 : ℚ) ≤ ℓ := by exact_mod_cast h
  have hp : (0 : ℚ) < ((ℓ : ℚ) - 1) * (ℓ : ℚ) ^ s := by
    have : (0 : ℚ) < (ℓ : ℚ) ^ s := by positivity
    nlinarith
  rw [sub_nonneg, div_le_one hp]
  have h3 : (ℓ : ℚ) ^ k ≤ (ℓ : ℚ) ^ s := pow_le_pow_right₀ (by linarith) hks
  have : (0 : ℚ) ≤ (ℓ : ℚ) ^ s := by positivity
  nlinarith

/-- an `ℓ`-group generated by `k` elements. -/
theorem pgroup_k {A : Type*} [AddCommGroup A] [Fintype A] {ℓ a k s : ℕ} [Fact ℓ.Prime] (hks : k ≤ s)
    (hcard : Fintype.card A = ℓ ^ a) (hA : HasGen A k) :
    pfk ℓ k s ≤ (genCount A s : ℚ) / (Fintype.card A : ℚ) ^ s := by
  classical
  have hb := pgroup_fail_bound (A := A) (ℓ := ℓ) (k := k) (a := a) hcard hA s
  have hle := genCount_le (A := A) s
  have hℓ : (2 : ℕ) ≤ ℓ := (Fact.out : ℓ.Prime).two_le
  have hℓq : (2 : ℚ) ≤ ℓ := by exact_mod_cast hℓ
  set N := Fintype.card A with hN
  have hNpos : 0 < N := Fintype.card_pos
  have hq : (((N : ℚ) ^ s - genCount A s) * (((ℓ : ℚ) - 1) * (ℓ : ℚ) ^ s)) ≤ ((ℓ : ℚ) ^ k - 1) * (N : ℚ) ^ s := by
    have h1 := (Nat.cast_le (α := ℚ)).2 hb
    have e1 : (1 : ℕ) ≤ ℓ := by omega
    have e2 : (1 : ℕ) ≤ ℓ ^ k := Nat.one_le_pow _ _ (by omega)
    push_cast [Nat.cast_sub hle, Nat.cast_sub e1, Nat.cast_sub e2] at h1
    exact h1
  have hX : (0 : ℚ) < (N : ℚ) ^ s := by positivity
  have hD : (0 : ℚ) < ((ℓ : ℚ) - 1) * (ℓ : ℚ) ^ s := by
    have : (0 : ℚ) < (ℓ : ℚ) ^ s := by positivity
    nlinarith
  unfold pfk
  rw [le_div_iff₀ hX]
  have h3 : (N : ℚ) ^ s - genCount A s ≤ ((ℓ : ℚ) ^ k - 1) * (N : ℚ) ^ s / (((ℓ : ℚ) - 1) * (ℓ : ℚ) ^ s) := by
    rw [le_div_iff₀ hD]; exact hq
  calc (1 - ((ℓ : ℚ) ^ k - 1) / (((ℓ : ℚ) - 1) * (ℓ : ℚ) ^ s)) * (N : ℚ) ^ s
      = (N : ℚ) ^ s - ((ℓ : ℚ) ^ k - 1) * (N : ℚ) ^ s / (((ℓ : ℚ) - 1) * (ℓ : ℚ) ^ s) := by ring
    _ ≤ ((genCount A s : ℕ) : ℚ) := by linarith

/-- **Lemma gen for `k` generators.** -/
theorem gen_k_prob {k s : ℕ} (hks : k ≤ s) : ∀ (N : ℕ) (A : Type u_1) [AddCommGroup A] [Fintype A],
    Fintype.card A = N → HasGen A k →
    ∏ ℓ ∈ N.primeFactors, pfk ℓ k s ≤ (genCount A s : ℚ) / (N : ℚ) ^ s := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
  intro A _ _ hN hA
  classical
  have hN0 : N ≠ 0 := by rw [← hN]; exact Fintype.card_ne_zero
  by_cases hN1 : N = 1
  · subst hN1
    have hsub : Subsingleton A := Fintype.card_le_one_iff_subsingleton.1 hN.le
    have : genCount A s = 1 := by
      have h1 := genCount_le (A := A) s
      have h2 : genCount A s ≠ 0 := by
        unfold genCount
        rw [← Nat.pos_iff_ne_zero, Finset.card_pos]
        refine ⟨fun _ => 0, ?_⟩
        simp only [mem_filter, mem_univ, true_and]
        exact eq_top_iff.2 fun x _ => by rw [Subsingleton.elim x 0]; exact zero_mem _
      rw [hN] at h1; simp at h1; omega
    simp [this]
  · have hℓ : (N.minFac).Prime := Nat.minFac_prime hN1
    set ℓ := N.minFac with hℓdef
    haveI : Fact ℓ.Prime := ⟨hℓ⟩
    set a := N.factorization ℓ with ha
    set n1 := ℓ ^ a with hn1
    set n2 := N / n1 with hn2
    have hdvd : n1 ∣ N := Nat.ordProj_dvd N ℓ
    have h12 : n1 * n2 = N := Nat.mul_div_cancel' hdvd
    have hcop1 : Nat.Coprime ℓ n2 := Nat.coprime_ordCompl hℓ hN0
    have hc : Nat.Coprime n1 n2 := hcop1.pow_left a
    have h0 : ∀ x : A, (n1 * n2) • x = 0 := by
      intro x; rw [h12, ← hN]; exact card_nsmul_eq_zero
    let e := splitEquiv (A := A) n1 n2 hc h0
    set A1 := ↥(nsmulAddMonoidHom (α := A) n1).ker with hA1
    set A2 := ↥(nsmulAddMonoidHom (α := A) n2).ker with hA2
    have hcardA : Fintype.card A1 * Fintype.card A2 = N := by
      rw [← hN, ← Fintype.card_prod]; exact Fintype.card_congr e.toEquiv
    have hA1pos : 0 < Fintype.card A1 := Fintype.card_pos
    have hA2pos : 0 < Fintype.card A2 := Fintype.card_pos
    -- A1 is an ℓ-group
    have hq1 : ∀ q : ℕ, q.Prime → q ∣ Fintype.card A1 → q = ℓ := by
      intro q hq hqd
      haveI : Fact q.Prime := ⟨hq⟩
      obtain ⟨x, hx⟩ := exists_prime_addOrderOf_dvd_card q hqd
      have hx0 : n1 • x = 0 := by
        have h : n1 • (x : A) = 0 := x.2
        exact Subtype.ext h
      have : q ∣ n1 := hx ▸ addOrderOf_dvd_of_nsmul_eq_zero hx0
      exact (Nat.prime_dvd_prime_iff_eq hq hℓ).1 (hq.dvd_of_dvd_pow this)
    obtain ⟨b, hc1⟩ : ∃ b, Fintype.card A1 = ℓ ^ b :=
      ⟨_, Nat.eq_prime_pow_of_unique_prime_dvd hA1pos.ne' (fun {d} hd hdd => hq1 d hd hdd)⟩
    have hnd2 : ¬ ℓ ∣ Fintype.card A2 := by
      intro hd
      obtain ⟨x, hx⟩ := exists_prime_addOrderOf_dvd_card ℓ hd
      have hx0 : n2 • x = 0 := by
        have h : n2 • (x : A) = 0 := x.2
        exact Subtype.ext h
      have : ℓ ∣ n2 := hx ▸ addOrderOf_dvd_of_nsmul_eq_zero hx0
      have := Nat.Coprime.eq_one_of_dvd hcop1 this
      exact hℓ.one_lt.ne' this
    have hb1 : b ≠ 0 := by
      intro hb0
      rw [hb0, pow_zero] at hc1
      rw [hc1, one_mul] at hcardA
      exact hnd2 (hcardA ▸ Nat.minFac_dvd N)
    have hlt : Fintype.card A2 < N := by
      have : 2 ≤ Fintype.card A1 := by
        rw [hc1]; calc 2 ≤ ℓ := hℓ.two_le
          _ ≤ ℓ ^ b := Nat.le_self_pow hb1 ℓ
      nlinarith
    have hgen1 : HasGen A1 k := hasGen_of_surj (AddMonoidHom.fst A1 A2)
      Prod.fst_surjective (hasGen_of_equiv e.symm hA)
    have hgen2 : HasGen A2 k := hasGen_of_surj (AddMonoidHom.snd A1 A2)
      Prod.snd_surjective (hasGen_of_equiv e.symm hA)
    have hP1 := pgroup_k (A := A1) (ℓ := ℓ) (a := b) hks hc1 hgen1
    have hP2 := ih _ hlt A2 rfl hgen2
    have hcopA : Nat.Coprime (Fintype.card A1) (Fintype.card A2) := by
      rw [hc1]; exact (Nat.Coprime.pow_left _ ((Nat.Prime.coprime_iff_not_dvd hℓ).2 hnd2))
    have hgen : genCount A s = genCount A1 s * genCount A2 s := by
      rw [← genCount_equiv e s]; exact genCount_prod hcopA s
    have hpf : N.primeFactors = insert ℓ (Fintype.card A2).primeFactors := by
      rw [← hcardA, Nat.primeFactors_mul hA1pos.ne' hA2pos.ne', hc1, Nat.primeFactors_prime_pow hb1 hℓ]
      rfl
    have hnot : ℓ ∉ (Fintype.card A2).primeFactors := by
      intro h; exact hnd2 (Nat.dvd_of_mem_primeFactors h)
    rw [hpf, Finset.prod_insert hnot, hgen]
    have hN2 : (N : ℚ) ^ s = (Fintype.card A1 : ℚ) ^ s * (Fintype.card A2 : ℚ) ^ s := by
      rw [← hcardA]; push_cast; ring
    rw [hN2, Nat.cast_mul, mul_div_mul_comm]
    exact mul_le_mul hP1 hP2 (Finset.prod_nonneg fun q hq => pfk_nonneg hks (Nat.prime_of_mem_primeFactors hq).two_le)
      (div_nonneg (by positivity) (by positivity))

theorem gen_k_product {A : Type*} [AddCommGroup A] [Fintype A] {k s : ℕ} (hks : k ≤ s) (hA : HasGen A k) :
    ∏ ℓ ∈ (Fintype.card A).primeFactors, pfk ℓ k s ≤ (genCount A s : ℚ) / (Fintype.card A : ℚ) ^ s :=
  gen_k_prob hks _ A rfl hA

theorem pfk_ge_gq {ℓ k s : ℕ} (hks : k + 1 ≤ s) (h : 2 ≤ ℓ) : gq ℓ ≤ pfk ℓ k s := by
  unfold pfk gq
  have h2 : (2 : ℚ) ≤ ℓ := by exact_mod_cast h
  have hl1 : (0 : ℚ) < (ℓ : ℚ) - 1 := by linarith
  have hlp : (0 : ℚ) < (ℓ : ℚ) ^ k := by positivity
  have hs : (ℓ : ℚ) ^ s = (ℓ : ℚ) ^ (k + 1) * (ℓ : ℚ) ^ (s - (k + 1)) := by
    rw [← pow_add]; congr 1; omega
  have hge : (1 : ℚ) ≤ (ℓ : ℚ) ^ (s - (k + 1)) := one_le_pow₀ (by linarith)
  have hD : (0 : ℚ) < ((ℓ : ℚ) - 1) * (ℓ : ℚ) ^ s := by
    have : (0 : ℚ) < (ℓ : ℚ) ^ s := by positivity
    nlinarith
  suffices ((ℓ : ℚ) ^ k - 1) / (((ℓ : ℚ) - 1) * (ℓ : ℚ) ^ s) ≤ 1 / ((ℓ : ℚ) * ((ℓ : ℚ) - 1)) by linarith
  rw [div_le_div_iff₀ hD (by positivity)]
  have : (ℓ : ℚ) ^ (k + 1) = (ℓ : ℚ) ^ k * ℓ := pow_succ _ _
  rw [hs, this]
  have hx : (0 : ℚ) ≤ (ℓ : ℚ) ^ k * ℓ := by positivity
  nlinarith [mul_le_mul_of_nonneg_left hge hx, mul_pos hl1 hlp]

/-- **Lemma gen, `k` generators, `s ≥ k+1` uniform elements: success probability at least `5/16`.** -/
theorem gen_k_explicit {A : Type*} [AddCommGroup A] [Fintype A] {k s : ℕ} (hks : k + 1 ≤ s)
    (hA : HasGen A k) : (5 / 16 : ℚ) ≤ (genCount A s : ℚ) / (Fintype.card A : ℚ) ^ s := by
  have h1 := gen_k_product (by omega : k ≤ s) hA
  have hprime : ∀ ℓ ∈ (Fintype.card A).primeFactors, ℓ.Prime := fun ℓ hℓ => Nat.prime_of_mem_primeFactors hℓ
  refine le_trans (prod_gq_ge _ hprime) (le_trans ?_ h1)
  apply Finset.prod_le_prod₀
  · intro i hi; exact gq_nonneg (hprime i hi).two_le
  · intro i hi; exact pfk_ge_gq hks (hprime i hi).two_le

/-- **Unconditional Lemma gen (no rank hypothesis).**  Any finite abelian `A` is generated by
`Nat.log 2 |A|` elements, so `s ≥ Nat.log 2 |A| + 1` uniform elements generate `A` with probability `≥ 5/16`. -/
theorem gen_log_explicit {A : Type*} [AddCommGroup A] [Fintype A] {s : ℕ}
    (hs : Nat.log 2 (Fintype.card A) + 1 ≤ s) :
    (5 / 16 : ℚ) ≤ (genCount A s : ℚ) / (Fintype.card A : ℚ) ^ s :=
  gen_k_explicit hs exists_hasGen_log'

end ECDLP.L119
